{
  "expo": {
    "name": "EV-Charge-Platform-App",
    "slug": "EV-Charge-Platform-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/Charge-Mate-Logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo/Charge-Mate-Logo-Full.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/Charge-Mate-Logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.term164.EVChargePlatformApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3e940edf-3859-43ee-b84f-8621371b29b3"
      }
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
